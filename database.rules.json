
{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "shipments": {
      ".indexOn": ["clientId", "driverId", "status"],
      "$shipmentId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "ratings": {
      ".indexOn": ["shipmentId", "ratedUserId", "raterUserId"],
      "$ratingId": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}